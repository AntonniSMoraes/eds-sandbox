# Copie para .env e ajuste. Todos os scripts em local/ leem daqui.

# --- AEM SDK (author local) ---
AEM_SDK_DIR=/Users/luizfrare/aem-sdk/crx-quickstart
AEM_AUTHOR_PORT=4502
AEM_AUTHOR_USER=admin
AEM_AUTHOR_PASSWORD=admin
AEM_JVM_OPTS=-server -Xmx4096m -Djava.awt.headless=true

# --- Identidade EDS ---
# Precisa bater EXATAMENTE com o org/repo informados no wizard "Create Site"
# do AEM, senão /bin/franklin.delivery devolve 404.
EDS_ORG=local
EDS_SITE=sandbox
EDS_BRANCH=main

# --- Portas ---
FRANKLIN_PROXY_PORT=4503
UES_PORT=8000
UES_TLS_PORT=8001
AEM_TLS_PORT=8443
AEM_CLI_PORT=3000

# Injeta o head.html local no HTML vindo do author quando ele não trouxer
# as tags de script/estilo do EDS (o author local não tem code bus).
INJECT_HEAD=1
