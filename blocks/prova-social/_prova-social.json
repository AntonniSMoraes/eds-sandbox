{
  "definitions": [
    {
      "title": "Prova Social",
      "id": "prova-social",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Prova Social",
              "model": "prova-social",
              "filter": "prova-social",
              "titulo": "Quem já confia na gente"
            }
          }
        }
      }
    },
    {
      "title": "Logo de cliente",
      "id": "prova-logo",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Logo",
              "model": "prova-logo"
            }
          }
        }
      }
    },
    {
      "title": "Número em destaque",
      "id": "prova-numero",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Número",
              "model": "prova-numero",
              "valor": "98%",
              "rotulo": "de satisfação"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "prova-social",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Estilo",
          "valueType": "string",
          "description": "Escolha um estilo. Não escolher nada faz o bloco herdar o ambiente da seção. Os itens de formato são ajuste opcional",
          "options": [
            {
              "name": "Impacto — campanha, escuro e imponente",
              "value": "wj-r-impacto"
            },
            {
              "name": "Lançamento — cor da marca, alto contraste",
              "value": "wj-r-lancamento"
            },
            {
              "name": "Institucional — claro e equilibrado",
              "value": "wj-r-institucional"
            },
            {
              "name": "Editorial — claro, arejado, para leitura",
              "value": "wj-r-editorial"
            },
            {
              "name": "Discreto — neutro e compacto",
              "value": "wj-r-discreto"
            },
            {
              "name": "Formato: faixa em linha",
              "value": "wj-prova-linha"
            },
            {
              "name": "Formato: com separadores",
              "value": "wj-prova-separado"
            },
            {
              "name": "Logos: cor original",
              "value": "wj-prova-colorido"
            }
          ]
        },
        {
          "component": "text",
          "name": "titulo",
          "label": "Chamada",
          "valueType": "string",
          "description": "Opcional. Ex.: Quem já confia na gente"
        }
      ]
    },
    {
      "id": "prova-logo",
      "fields": [
        {
          "component": "reference",
          "name": "imagem",
          "label": "Logo",
          "multi": false
        },
        {
          "component": "text",
          "name": "imagemAlt",
          "label": "Nome da empresa",
          "valueType": "string",
          "description": "Vira o texto alternativo. Escreva o nome da empresa, não a palavra logo"
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link (opcional)"
        }
      ]
    },
    {
      "id": "prova-numero",
      "fields": [
        {
          "component": "text",
          "name": "valor",
          "label": "Número",
          "valueType": "string",
          "required": true,
          "description": "Curto e com unidade. Ex.: 98%, +2 mil, 4,8/5"
        },
        {
          "component": "text",
          "name": "rotulo",
          "label": "O que ele significa",
          "valueType": "string",
          "required": true,
          "description": "Ex.: de satisfação, clientes ativos, nota no G2"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "prova-social",
      "components": [
        "prova-logo",
        "prova-numero"
      ]
    }
  ]
}
